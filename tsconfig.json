{
    "include": [
        "./src/**/*.ts",
        "./test/*.ts",
        "./test/**/*.ts",
        "./*.js"
    ],
    "exclude": [
        "./dist/**/*",
        "./externals/**/*",
        "./legacy/**/*.ts",
        "./src/**/*.js",
        "./src/**/*.jsx"
    ],
    "compilerOptions": {
        "outDir": "./dist/",
        "paths": {
            "@phosphor-icons/core/assets/*": [
                "../../../node_modules/@phosphor-icons/core/assets/*"
            ],
            "views/types": [
                "../../shared/types.ts"
            ],
            "views/registry": [
                "../../shared/registry.ts"
            ],
            "views/apis/channel-actions": [
                "../../projects/subsystem/src/routing/api/channel-actions.ts"
            ],
            "com/config/Settings": [
                "../../projects/subsystem/src/other/config/Settings.ts"
            ],
            "com/config/SettingsTypes": [
                "../../projects/subsystem/src/other/config/SettingsTypes.ts"
            ],
            "com/config/settings/register-builtin-contributions": [
                "../../projects/subsystem/src/other/config/settings/register-builtin-contributions.ts"
            ],
            "com/config/settings/settings-shell-profile": [
                "../../projects/subsystem/src/other/config/settings/settings-shell-profile.ts"
            ],
            "@fest-lib/*": [
                "../../shared/fest/*"
            ],
            "@fest-lib/dom": [
                "../../projects/dom.ts/src/index.ts"
            ],
            "@fest-lib/lure": [
                "../../projects/lur.e/src/index.ts"
            ],
            "@fest-lib/object": [
                "../../projects/object.ts/src/index.ts"
            ],
            "@fest-lib/core": [
                "../../projects/core.ts/src/index.ts"
            ],
            "@fest-lib/icon": [
                "../../projects/icon.ts/src/index.ts"
            ],
            "@fest-lib/fl-ui": [
                "../../projects/fl.ui/src/index.ts"
            ],
            "@fest-lib/image": [
                "../../projects/image.ts/src/index.ts"
            ],
            "@fest-lib/ui": [
                "../../projects/fl.ui/src/index.ts"
            ],
            "@fest-lib/uniform": [
                "../../projects/uniform.ts/src/index.ts"
            ],
            "@fest-lib/polyfill/*": [
                "../../projects/shared/fest/polyfill/*"
            ],
            "polyfill/*": [
                "../../projects/shared/fest/polyfill/*"
            ],
            "veela-lib": [
                "../../projects/veela.css/src/scss/index.scss"
            ],
            "veela-lib/*": [
                "../../projects/veela.css/src/scss/*"
            ],
            "boot/*": ["../shared/src/boot/*"],
            "views/*": ["../shared/views/*"],
            "shells/*": ["../shared/shells/*"],
            "core/*": ["../shared/src/*"],
            "com/*": ["../shared/src/*"],
            "shared/*": ["../shared/src/*"],
            "cwsp-shared/*": ["../../projects/cwsp-shared/src/*"],
            "@fest-lib/cwsp-shared": ["../../projects/cwsp-shared/src/index.ts"],
            "@shared/*": ["../shared/*"],
            "fonts/*": ["../shared/assets/fonts/*"],
            "shells/immersive/index": ["../../shells/immersive-shell/src/index.ts"],
            "shells/content/index": ["../../shells/content-shell/src/index.ts"],
            "shells/minimal/preview": ["../../shells/minimal-shell/src/preview.ts"]
        },
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ESNext",
            "DOM",
            "WebWorker"
        ],
        "esModuleInterop": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "allowArbitraryExtensions": true,
        "allowSyntheticDefaultImports": true,
        "allowUmdGlobalAccess": true,
        "allowUnreachableCode": true,
        "allowUnusedLabels": true,
        "noImplicitAny": false,
        "declaration": false,
        "noImplicitThis": false,
        "inlineSources": true,
        "inlineSourceMap": true,
        "sourceMap": false,
        "typeRoots": [
            "plugins/global.d.ts"
        ],
        "experimentalDecorators": true,
        "noEmit": true,
        "noEmitOnError": true,
        "noEmitHelpers": true
    },
    "compileOnSave": false
}
